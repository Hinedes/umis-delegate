# --- Security ----------------------------------------------------------------
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=False

# --- Database ----------------------------------------------------------------
POSTGRES_DB=umis
POSTGRES_USER=umis
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Hosts -------------------------------------------------------------------
# Replace with the public deployment hostname, e.g. umis.example.com.
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Full scheme required, e.g. http://192.168.1.10:8000,https://umis.example.com
CSRF_TRUSTED_ORIGINS=
# Number of reverse proxies that append to X-Forwarded-For. Default 1.
TRUSTED_PROXY_COUNT=1

# --- Cookies / HTTPS -----------------------------------------------------------
# Production-safe defaults: secure cookies on, redirect off until HTTPS is
# verified. For a plain-HTTP demo set both cookie flags to False and leave the
# redirect off; enable SECURE_SSL_REDIRECT only with HTTPS and a real hostname.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False

# --- Application -------------------------------------------------------------
SITE_NAME=UMIS-D
# Destructive demo reset is opt-in; never enable on a real clinic database.
DEMO_ALLOW_RESET=False
# Shared password for the demo accounts seed_demo creates. Blank = random,
# printed once by seed_demo. Never use a password that is published anywhere.
DEMO_PASSWORD=
TIME_ZONE=UTC
LANGUAGE_CODE=en
SESSION_COOKIE_AGE=43200
SESSION_WARN_SECONDS=120
LOG_LEVEL=INFO
# Two-letter country code so staff can type national phone numbers (for example KG).
PHONENUMBER_DEFAULT_REGION=

# --- Clinic hours ------------------------------------------------------------
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=18
BOOKING_SLOT_MINUTES=30

# --- Agent control ------------------------------------------------------------
# Vultr Serverless Inference. Leave the key blank to disable the agent;
# it then reports a configuration error instead of running.
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_TIMEOUT=90
